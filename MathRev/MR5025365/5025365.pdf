   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Analysis of the expected L2 error of an over-parametrized deep neural network estimate learned by gradient descent without regularization</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Electronic Journal of Statistics </rdf:li>
